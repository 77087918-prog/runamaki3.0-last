# Railway Environment Configuration
# Variables que Railway debe configurar automáticamente

# App
APP_ENV=production
APP_DEBUG=false
APP_KEY=${RAILWAY_GEN_APP_KEY}
APP_URL=${RAILWAY_STATIC_URL}

# Database (Railway PostgreSQL)
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# WebSocket Reverb (Railway)
BROADCAST_DRIVER=reverb
REVERB_APP_ID=railway-app
REVERB_APP_KEY=railway-key-${RANDOM_SECRET_1}
REVERB_APP_SECRET=railway-secret-${RANDOM_SECRET_2}
REVERB_HOST=${RAILWAY_STATIC_URL}
REVERB_PORT=443
REVERB_SCHEME=https

# Pusher/Echo config for client
PUSHER_APP_ID=${REVERB_APP_ID}
PUSHER_APP_KEY=${REVERB_APP_KEY}
PUSHER_APP_SECRET=${REVERB_APP_SECRET}
PUSHER_HOST=${RAILWAY_STATIC_URL}
PUSHER_PORT=443
PUSHER_SCHEME=https

# Vite
VITE_PUSHER_APP_KEY=${REVERB_APP_KEY}
VITE_PUSHER_HOST=${RAILWAY_STATIC_URL}
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https

# Session & Cache
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# Security
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

# Logging
LOG_CHANNEL=single
LOG_LEVEL=info

# Mail (Railway)
MAIL_MAILER=smtp
MAIL_HOST=${RAILWAY_MAIL_HOST}
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# Locale
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES